#!/usr/bin/env python3
"""Draw omaorchestra's logo from the brand board ("Pixel Hop"): the app icon,
light and dark tiles, the README wordmarks, favicons and GitHub's social
preview.

The mark is a pixel "o" whose top-right corner has hopped off as a spark,
drawn on an 11 x 12 grid. In the wordmark it is the first "o" of
omaorchestra; the rest is JetBrains Mono Bold (Omarchy's default font),
turned into outlines so it looks the same where the font is missing.

Needs fontTools and rsvg-convert:

    python -m venv /tmp/ft && /tmp/ft/bin/pip install fonttools
    /tmp/ft/bin/python scripts/logo
"""

import subprocess
import tempfile
from pathlib import Path

from fontTools.pens.boundsPen import BoundsPen
from fontTools.pens.svgPathPen import SVGPathPen
from fontTools.pens.transformPen import TransformPen
from fontTools.ttLib import TTFont

ROOT = Path(__file__).resolve().parent.parent
ASSETS = ROOT / "docs" / "assets"
FONT_FILE = "/usr/share/fonts/TTF/JetBrainsMonoNerdFont-Bold.ttf"

INK = "#17181c"        # the dark tile, and the mark on light
PAPER = "#eeeae1"      # the light tile, and the mark on dark
EDGE = "#dcd7cc"       # the light tile's outline
SPARK = "#d9731a"      # the spark; its trail is the same at 45%
TRAIL_OPACITY = 0.45
MUTED = "#8f8c84"      # "ma" in the wordmark

# The mark: O = spark, s = its trail, # = the ring.
MARK = [
    ".........OO",
    ".........OO",
    "........s..",
    "..#####....",
    ".######....",
    "##.....##..",
    "##.....##..",
    "##.....##..",
    "##.....##..",
    "##.....##..",
    ".#######...",
    "..#####....",
]
COLS, ROWS = len(MARK[0]), len(MARK)


def mark(x, y, cell, ring):
    """The mark as SVG rects: one per run of cells in a row."""
    fills = {"#": f'fill="{ring}"', "O": f'fill="{SPARK}"',
             "s": f'fill="{SPARK}" fill-opacity="{TRAIL_OPACITY}"'}
    rects = []
    for r, row in enumerate(MARK):
        c = 0
        while c < COLS:
            kind = row[c]
            end = c
            while end < COLS and row[end] == kind:
                end += 1
            if kind in fills:
                rects.append(f'<rect x="{x + c * cell:g}" y="{y + r * cell:g}" width="{(end - c) * cell:g}" '
                             f'height="{cell:g}" {fills[kind]}/>')
            c = end
    return "\n  ".join(rects)


def svg(width, height, body, view=None, size=None):
    view = view or f"0 0 {width:g} {height:g}"
    w, h = size or (width, height)
    return (f'<svg xmlns="http://www.w3.org/2000/svg" viewBox="{view}" width="{w:g}" height="{h:g}" '
            f'shape-rendering="crispEdges">\n  <title>omaorchestra</title>\n  {body}\n</svg>\n')


def tile(theme):
    """The app icon: 520 units, 28-unit cells, as on the board."""
    if theme == "dark":
        back = f'<rect width="520" height="520" rx="54" fill="{INK}" shape-rendering="geometricPrecision"/>'
        ring = PAPER
    else:
        back = (f'<rect x="1" y="1" width="518" height="518" rx="53" fill="{PAPER}" stroke="{EDGE}" '
                f'stroke-width="2" shape-rendering="geometricPrecision"/>')
        ring = INK
    return svg(520, 520, back + "\n  " + mark(91, 91, 28, ring), size=(128, 128))


def favicon(size):
    """The bare mark on light, in whole pixels: 1-pixel cells at 16, 2 at 32."""
    cell, x, y = {16: (1, 2, 2), 32: (2, 5, 4)}[size]
    return svg(size, size, mark(x, y, cell, INK))


class Font:
    def __init__(self, path):
        font = TTFont(path)
        self.glyphs, self.cmap = font.getGlyphSet(), font.getBestCmap()
        self.upm = font["head"].unitsPerEm

    def glyph(self, ch):
        return self.glyphs[self.cmap[ord(ch)]]

    def path(self, text, x, baseline, size):
        """`text` as one SVG path, and the x where it ends."""
        scale = size / self.upm
        pen = SVGPathPen(self.glyphs)
        for ch in text:
            g = self.glyph(ch)
            g.draw(TransformPen(pen, (scale, 0, 0, -scale, x, baseline)))
            x += g.width * scale
        return pen.getCommands(), x

    def left_bearing(self, ch, size):
        bounds = BoundsPen(self.glyphs)
        self.glyph(ch).draw(bounds)
        return bounds.bounds[0] * size / self.upm


def wordmark(font, theme):
    """The mark as the first "o", then "ma" muted and "orchestra" in full.

    Units are the board's pixels: 22/3-unit cells from (145, 708), letters
    41.7 units apart with the "m" starting at 244 and the baseline at 772.
    """
    ring = PAPER if theme == "dark" else INK
    size = 41.7 * font.upm / font.glyph("m").width
    x = 244 - font.left_bearing("m", size)
    ma, x = font.path("ma", x, 772, size)
    rest, end = font.path("orchestra", x, 772, size)
    body = (mark(145, 708, 22 / 3, ring) + f'\n  <path fill="{MUTED}" d="{ma}" shape-rendering="geometricPrecision"/>'
            f'\n  <path fill="{ring}" d="{rest}" shape-rendering="geometricPrecision"/>')
    width, height = end - 145, 88
    return svg(width, height, body, view=f"145 708 {width:.1f} {height}", size=(round(width * 72 / 88), 72))


def social(font):
    """GitHub's social preview, 1280x640: the wordmark and a tagline on ink."""
    word = wordmark(font, "dark")
    inner = word.split("</title>\n  ", 1)[1].rsplit("\n</svg>", 1)[0]
    width = float(word.split('viewBox="145 708 ', 1)[1].split()[0])
    scale = 1.6
    left, top = (1280 - width * scale) / 2, 250
    tagline, tag_end = font.path("Conduct your AI coding agents on Omarchy", 0, 0, 30)
    return (f'<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1280 640" width="1280" height="640">\n'
            f'  <rect width="1280" height="640" fill="{INK}"/>\n'
            f'  <g transform="translate({left - 145 * scale:.1f} {top - 708 * scale:.1f}) scale({scale})">\n  {inner}\n  </g>\n'
            f'  <g transform="translate({(1280 - tag_end) / 2:.1f} 470)"><path fill="{MUTED}" d="{tagline}"/></g>\n'
            f'</svg>\n')


def render_png(svg_text, out):
    with tempfile.NamedTemporaryFile("w", suffix=".svg") as f:
        f.write(svg_text)
        f.flush()
        subprocess.run(["rsvg-convert", f.name, "-o", str(out)], check=True)


def main():
    font = Font(FONT_FILE)
    ASSETS.mkdir(parents=True, exist_ok=True)
    written = {
        ROOT / "packaging" / "icons" / "omaorchestra.svg": tile("dark"),
        ASSETS / "icon-dark.svg": tile("dark"),
        ASSETS / "icon-light.svg": tile("light"),
        ASSETS / "logo-dark.svg": wordmark(font, "dark"),
        ASSETS / "logo-light.svg": wordmark(font, "light"),
        ASSETS / "favicon.svg": favicon(32),
    }
    for path, text in written.items():
        path.write_text(text)
    render_png(favicon(16), ASSETS / "favicon-16.png")
    render_png(favicon(32), ASSETS / "favicon-32.png")
    render_png(social(font), ASSETS / "social-preview.png")
    for path in [*written, *(ASSETS / n for n in ("favicon-16.png", "favicon-32.png", "social-preview.png"))]:
        print(path.relative_to(ROOT))


if __name__ == "__main__":
    main()
