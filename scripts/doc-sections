#!/usr/bin/python3
"""Keep a "Sections:" line under each doc's title: a link to each of its
`##` sections, so a reader sees what the page holds before scrolling.

    scripts/doc-sections           # rewrite the line in every docs/*.md
    scripts/doc-sections --check   # exit 1 if any is out of date (a test runs this)

The line sits between <!-- sections --> markers right after the `# Title`,
and is replaced whole each time. docs/commands.md is generated by
scripts/commands, which adds its own line with the same function.
docs/ROADMAP.md is private and left alone.
"""

import argparse
import re
import sys
import unicodedata
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
START, END = "<!-- sections -->", "<!-- /sections -->"
SKIP = ("ROADMAP.md", "commands.md")


def slug(heading):
    """GitHub's anchor for a heading: lower case, only letters, digits,
    spaces, hyphens and underscores kept, spaces as hyphens."""
    text = heading.strip().lower()
    text = "".join(c for c in text if c in " -_" or unicodedata.category(c)[0] in "LN")
    return text.replace(" ", "-")


def headings(text):
    """(level, heading text, anchor) for every heading outside code blocks,
    with GitHub's -1, -2... on repeated anchors."""
    out, seen, fence = [], {}, None
    for line in text.splitlines():
        stripped = line.lstrip()
        marker = re.match(r"(`{3,}|~{3,})", stripped)
        if marker:
            if fence is None:
                fence = marker.group(1)[0]
            elif stripped.startswith(fence * 3):
                fence = None
            continue
        if fence:
            continue
        m = re.match(r"^(#{1,6})\s+(.+?)\s*#*\s*$", line)
        if not m:
            continue
        base = slug(m.group(2))
        count = seen.get(base, 0)
        seen[base] = count + 1
        out.append((len(m.group(1)), m.group(2), base if count == 0 else f"{base}-{count}"))
    return out


def label(heading):
    return heading.replace("`", "")


def block(text):
    """The sections line for a page's text (without any old line)."""
    links = [f"[{label(h)}](#{anchor})" for level, h, anchor in headings(strip(text)) if level == 2]
    return f"{START}\n**Sections:** " + " · ".join(links) + f"\n{END}" if links else ""


def strip(text):
    """The page without its sections line."""
    return re.sub(rf"\n*{re.escape(START)}.*?{re.escape(END)}\n*", "\n\n", text, flags=re.S)


def apply(text):
    """The page with an up-to-date sections line right after its title."""
    text = strip(text)
    line = block(text)
    if not line:
        return text
    lines = text.split("\n")
    title = next((i for i, l in enumerate(lines) if l.startswith("# ")), None)
    if title is None:
        return text
    rest = "\n".join(lines[title + 1:]).lstrip("\n")
    return "\n".join(lines[:title + 1]) + "\n\n" + line + "\n\n" + rest


def main():
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    parser.add_argument("--check", action="store_true", help="only report pages out of date")
    args = parser.parse_args()
    stale = []
    for page in sorted((ROOT / "docs").glob("*.md")):
        if page.name in SKIP:
            continue
        text = page.read_text()
        new = apply(text)
        if new != text:
            stale.append(page.relative_to(ROOT))
            if not args.check:
                page.write_text(new)
    if args.check and stale:
        print("out of date: " + ", ".join(map(str, stale)) + "; run scripts/doc-sections", file=sys.stderr)
        return 1
    for page in stale:
        print(page)
    return 0


if __name__ == "__main__":
    sys.exit(main())
