#!/usr/bin/python3
"""Render the README screenshots: the app, offscreen, against a throwaway
daemon holding made-up sessions and tasks. Nothing from this machine's own
sessions, projects, keys or theme appears: the app draws in its built-in
neutral dark palette, or in a stock Omarchy theme with --theme.

    scripts/screenshots [--theme <omarchy theme>] [output dir]   # default: docs/screenshots
"""

import json
import os
import shutil
import subprocess
import sys
import tempfile
import time
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(ROOT / "src"))
os.environ["QT_QPA_PLATFORM"] = "offscreen"

SESSIONS = [
    ("a1", "needs-input", "website", {"message": "Claude needs your permission to use Bash: npm run build",
                                      "model": "claude-opus-5-5", "branch": "main",
                                      "title": "Fix the broken image paths"}),
    ("b2", "working", "api", {"model": "claude-sonnet-5", "branch": "omaorchestra/rate-limits-3f9a1c",
                              "title": "Add rate limiting to the public endpoints"}),
    ("c3", "working", "dotfiles", {"model": "claude-haiku-4-5", "title": "Tidy the zsh aliases"}),
    ("d4", "idle", "blog", {"model": "claude-sonnet-5", "branch": "drafts", "title": "Proofread the September post"}),
]
QUEUED = ["Update the dependencies and run the tests", "Write a changelog entry for 0.1.0"]
PAGES = [("sessions", "sessions.png"), ("new", "new-task.png"), ("queue", "queue.png"), ("history", "history.png"),
         ("usage", "usage.png"), ("mcp", "mcp.png")]
# Made-up ended sessions: (hours ago, project, agent, model, outcome, minutes, working minutes, usd, commits, title)
HISTORY = [
    (1, "api", "claude", "claude-sonnet-5", "finished", 34, 27, 1.84, 3, "Add request logging to the public endpoints"),
    (3, "website", "claude", "claude-opus-5-5", "finished", 52, 41, 4.12, 2, "Move the blog to the new layout"),
    (5, "dotfiles", "codex", "gpt-5.5-codex", "stopped", 9, 6, None, 0, "Try a faster shell prompt"),
    (26, "api", "claude", "claude-sonnet-5", "crashed", 14, 12, 0.61, 0, "Upgrade the database driver"),
    (28, "blog", "claude", "claude-haiku-4-5", "finished", 6, 4, 0.08, 1, "Fix typos in the September drafts"),
    (30, "website", "opencode", None, "never-started", 1, 0, None, 0, "Compress the hero images"),
]
# Subscription limits, as Omarchy's usage records hold them.
LIMITS = [("Session (5-hour)", 0.42, 3), ("Weekly (7-day)", 0.67, 70)]  # label, used, hours until reset
MCP_SERVERS = {
    "github": {"type": "http", "url": "https://api.githubcopilot.com/mcp/"},
    "playwright": {"command": "npx", "args": ["@playwright/mcp@latest"]},
    "postgres": {"command": "uvx", "args": ["postgres-mcp", "--access-mode=restricted"]},
}


def main():
    import argparse
    parser = argparse.ArgumentParser(description="Render the README screenshots.")
    parser.add_argument("--theme", help="a stock Omarchy theme (e.g. tokyo-night); default: the app's own palette")
    parser.add_argument("out", nargs="?", default=str(ROOT / "docs" / "screenshots"))
    args = parser.parse_args()
    out = Path(args.out).resolve()
    out.mkdir(parents=True, exist_ok=True)
    colors = None
    if args.theme:
        omarchy = Path(os.environ.get("OMARCHY_PATH") or "/usr/share/omarchy")
        colors = omarchy / "themes" / args.theme / "colors.toml"
        if not colors.exists():
            parser.error(f"no Omarchy theme {args.theme} ({colors})")

    with tempfile.TemporaryDirectory(prefix="oo-") as tmp:
        tmp = Path(tmp)
        home = tmp / "home"
        # A made-up home: paths show as ~/code/<project>, and no theme unless asked.
        for name in ("website", "api", "dotfiles", "blog"):
            (home / "code" / name).mkdir(parents=True)
        if colors:
            theme_dir = home / ".local" / "state" / "omarchy" / "current" / "theme"
            theme_dir.mkdir(parents=True)
            shutil.copy(colors, theme_dir / "colors.toml")
        seed(home)
        seed_history(tmp / "state", home)
        (tmp / "config.toml").write_text("[notifications]\nwaiting = false\nfinished_after = 0\n[tasks]\nmax_parallel = 4\n")
        os.environ.update({
            "HOME": str(home), "XDG_CONFIG_HOME": str(home / ".config"), "XDG_STATE_HOME": str(home / ".local" / "state"),
            "XDG_DATA_HOME": str(home / ".local" / "share"), "OMAORCHESTRA_SOCKET": str(tmp / "o.sock"),
            "OMAORCHESTRA_STATE_DIR": str(tmp / "state"), "OMAORCHESTRA_CONFIG": str(tmp / "config.toml"),
            # No session bus: the real keyring stays out of the pictures.
            "DBUS_SESSION_BUS_ADDRESS": "unix:path=" + str(tmp / "no-bus"),
        })
        env = {k: v for k, v in os.environ.items() if k != "JOURNAL_STREAM"}
        daemon = subprocess.Popen([str(ROOT / "bin" / "omaorchestra"), "daemon"], env=env, stderr=subprocess.DEVNULL)
        try:
            for _ in range(100):
                if (tmp / "o.sock").exists():
                    break
                time.sleep(0.05)
            render(home, out)
        finally:
            daemon.terminate()
            daemon.wait(timeout=5)


def seed(home):
    """Made-up usage records and MCP servers in the made-up home."""
    from datetime import datetime, timedelta, timezone
    now = datetime.now(timezone.utc)
    usage = home / ".local" / "state" / "omarchy" / "agents" / "usage"
    usage.mkdir(parents=True)
    (usage / "claude.json").write_text(json.dumps({
        "id": "claude", "name": "Claude Code", "ready": True, "updatedAt": now.isoformat(),
        "limits": [{"label": label, "percent": used, "resetsAt": (now + timedelta(hours=hours)).isoformat()}
                   for label, used, hours in LIMITS]}))
    (home / ".claude.json").write_text(json.dumps({"mcpServers": MCP_SERVERS}))


def seed_history(state, home):
    """Made-up ended sessions for the History page and the Usage stats."""
    state.mkdir(parents=True, exist_ok=True)
    now = time.time()
    with open(state / "history.jsonl", "w") as f:
        for n, (hours, project, agent, model, outcome, minutes, working, usd, commits, title) in enumerate(HISTORY):
            ended = now - hours * 3600
            f.write(json.dumps({
                "v": 1, "id": f"{n:08x}-demo", "agent": agent, "project": project,
                "cwd": str(home / "code" / project), "model": model, "provider": None,
                "started": ended - minutes * 60, "ended": ended,
                "seconds": {"working": working * 60, "needs-input": 60 if working else 0,
                            "idle": max(0, minutes - working - 1) * 60},
                "cost": {"usd": usd, "real": False} if usd else None, "branch": "main",
                "git": {"from": "0" * 40, "to": "1" * 40, "commits": commits} if commits else None,
                "waits": 1 if working else 0, "reason": "session-end", "outcome": outcome,
                "transcript": None, "title": title, "task": title}) + "\n")


def render(home, out):
    from PySide6.QtCore import QEventLoop, QTimer, QUrl
    from PySide6.QtGui import QGuiApplication
    from PySide6.QtQml import QQmlApplicationEngine
    from PySide6.QtQuick import QQuickWindow  # noqa: F401 (registers the types PySide converts)
    from PySide6.QtQuickControls2 import QQuickStyle
    from omaorchestra import __version__, client
    from omaorchestra.app import backend

    def spin(ms):
        loop = QEventLoop()
        QTimer.singleShot(ms, loop.quit)
        loop.exec()

    for sid, status, project, extra in SESSIONS:
        client.request({"cmd": "update", "session_id": sid, "agent": "claude", "status": status,
                        "cwd": str(home / "code" / project), **extra})
    for task in QUEUED:
        client.request({"cmd": "queue-add", "paused": True, "item": {"task": task, "cwd": str(home / "code" / "api")}})
    # A two-step recipe: the build is paused, its review waits for it.
    from omaorchestra import recipes
    after = None
    for step in recipes.items("build-then-review", "Add pagination to the search results",
                              str(home / "code" / "website"), base={"worktree": False}):
        step = {**step, "task": step["task"]}
        if after:
            step["after"] = after
        after = client.request({"cmd": "queue-add", "paused": not after, "item": step})["item"]["id"]

    app = QGuiApplication(sys.argv[:1])
    QQuickStyle.setStyle("Basic")
    sessions = backend.Sessions()
    objects = {"theme": backend.Theme(), "sessions": sessions, "settings": backend.Settings(),
               "worktrees": backend.Worktrees(), "queue": backend.Queue(sessions), "awayMode": backend.Away(sessions), "sessionHistory": backend.History(sessions),
               "providerList": backend.Providers(),
               "spend": backend.Spend(sessions), "mcp": backend.Mcp(sessions),
               "fontFamily": backend.monospace_family(), "appVersion": __version__, "initialSession": ""}
    engine = QQmlApplicationEngine()
    for name, value in objects.items():
        engine.rootContext().setContextProperty(name, value)
    engine.load(QUrl.fromLocalFile(str(ROOT / "src" / "omaorchestra" / "app" / "qml" / "Main.qml")))
    window = engine.rootObjects()[0]
    window.setWidth(1100)
    window.setHeight(720)
    sessions.start()
    spin(1500)
    for page, name in PAGES:
        window.setProperty("page", page)
        spin(600)
        window.grabWindow().save(str(out / name))
        print(out / name)
    app.quit()


if __name__ == "__main__":
    main()
