#!/bin/bash
# omarchy:summary=Coordinate AI coding agents
# Run from a source checkout when there is one next to this script.
src="$(dirname "$(readlink -f "$0")")/../src"
[[ -d $src/omaorchestra ]] && export PYTHONPATH="$src${PYTHONPATH:+:$PYTHONPATH}"
# Tell the CLI where it lives, so `hooks install` can point hooks at it.
export OMAORCHESTRA_BIN="$(readlink -f "$0")"
exec python3 -m omaorchestra "$@"
